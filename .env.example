# "Imkon-Ish" — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or API keys to GitHub!

# Application Configuration
APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true

# AI & LLM Services (Used in serverless backend functions / secure server)
# DO NOT expose secret keys directly in client-side bundles!
AI_API_PROVIDER=openai # openai | anthropic | gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=gpt-4o-mini

# Backend Database & Authentication (e.g. Supabase / Custom Node.js)
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Speech & Translation Services (Optional server-side endpoints)
TRANSLATION_API_KEY=
SPEECH_TO_TEXT_API_KEY=
